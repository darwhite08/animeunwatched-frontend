# Backend API base URL (no trailing slash) — change to deployed URL in production
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Socket.io URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Used by SSR fetches (server-side only, no NEXT_PUBLIC_ prefix)
API_BASE=http://localhost:4000

# Google OAuth Client ID (matches backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple Sign In Service ID (matches backend APPLE_CLIENT_ID)
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Sentry error monitoring — get DSN from https://sentry.io (leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
